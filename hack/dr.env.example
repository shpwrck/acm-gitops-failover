# Settings for hack/dr.sh, hack/build.sh and hack/teardown.sh. The Settings
# stage of hack/build.sh writes ~/acm-dr/dr.env from this; or copy it there
# (or point DR_ENV at your copy) and edit it. `hack/dr.sh rejoin` rewrites
# ACTIVE, PASSIVE and RUN at the end of a run, so the file always describes
# the current posture and the next run's number.

# kubeconfig holding the hub and managed-cluster contexts (build.md "Clusters")
KUBECONFIG=~/acm-dr/kubeconfig

# hub that is active now and is about to "die", and the hub that takes over
ACTIVE=hub-x
PASSIVE=hub-y

# workload cluster that re-homes
MANAGED=spoke

# routes of the two demo apps on $MANAGED (hack/build.sh writes them once the apps answer)
APP_URL=https://hello-failover-hello-failover.apps.spoke.example.com
PUSH_APP_URL=https://hello-failover-push-hello-failover-push.apps.spoke.example.com

# branch the clusters track (targetRevision); deploys and dr/ changes go here
BRANCH=main

# run number: names the run's log directory, ~/acm-dr/runs/run-$RUN
RUN=1

# S3 bucket both hubs back up to, for hack/build.sh (build.md "Backup storage").
# The access key and secret key are not set here: the build asks for them, or
# reads S3_ACCESS_KEY and S3_SECRET_KEY from the environment.
# S3_URL: the endpoint; empty means AWS S3. Left out, the build asks and saves it here.
# S3_URL=https://s3.example.com
S3_BUCKET=acm-backups
S3_PREFIX=acm
S3_REGION=us-east-1
# CA certificate (PEM) of the S3 endpoint, if it is not publicly trusted
S3_CA_FILE=
